{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Machines propose, humans schedule the risk. Patch and minor updates to dev-only tooling carry full pipeline evidence and can land unattended; anything else waits for a person.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions bumps so eight repos do not each open five PRs.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Never automerge a major. Batch these onto a calm day, never before a weekend.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "lockFileMaintenance": { "enabled": true }
}
